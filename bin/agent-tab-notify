#!/bin/bash
# agent-tab-notify
# Claude Code and Codex notifications that take you to the right terminal tab,
# and clear themselves once you have seen them.
#
# Subcommands:
#   notify    post a notification for this session   (Stop, Notification, PermissionRequest)
#   clear     drop this session's notification       (UserPromptSubmit hook)
#   watch     clear a tab's notification when you switch to it (background)
#   focus H   select the tab for handle H            (run by a notification click)
#   resolve   print this session's handle, tab name, tab position, and (iTerm2) tab count
#   doctor    check the pieces this depends on
#   prune     drop markers whose tab no longer exists (watch also does this)
#   config    show settings; config set NAME VALUE; config unset NAME

set -uo pipefail

# The click callback is stored inside every delivered notification, so this path
# must be the real one on disk. A symlinked or relative invocation would bake in
# a path that stops resolving the moment the caller's directory changes.
# The old name, bin/claude-code-tab-notify, is a symlink to this file, so old
# hooks and already-delivered notifications keep working. Resolve it, or the
# click callback would bake in the old name.
SELF_SOURCE="${BASH_SOURCE[0]}"
[ -L "$SELF_SOURCE" ] && SELF_SOURCE="$(dirname "$SELF_SOURCE")/$(readlink "$SELF_SOURCE")"
SELF_DIR=$(cd "$(dirname "$SELF_SOURCE")" && pwd -P)
SELF="$SELF_DIR/$(basename "$SELF_SOURCE")"

# ------------------------------------------------------------- settings ----

# Settings live in a file because the hooks and the watch agent start with
# different environments: a variable exported in your shell never reaches the
# launchd agent. An environment variable of the same name still wins, so a
# one-off override needs no edit.
CONFIG_FILE="${CCTN_CONFIG:-$HOME/.config/agent-tab-notify/config}"
# Before the rename the file lived under the old name; read it there until
# it has been moved.
if [ -z "${CCTN_CONFIG:-}" ] && [ ! -e "$CONFIG_FILE" ] && [ -e "$HOME/.config/claude-code-tab-notify/config" ]; then
    CONFIG_FILE="$HOME/.config/claude-code-tab-notify/config"
fi

# name|default|description. The order here is the order `config` prints.
SETTINGS_TABLE='CCTN_NOTIFY_ON_DONE|1|Notify when Claude finishes a reply
CCTN_NOTIFY_ON_INPUT|1|Notify when Claude needs permission or input
CCTN_NOTIFY_ON_IDLE|0|Notify for Claude Code'"'"'s "waiting for your input" reminder, which replaces the reply
CCTN_NOTIFY_WHILE_AGENTS_RUN|0|Notify when Claude stops but background agents are still working
CCTN_NOTIFY_WHEN_FOCUSED|0|Notify even when you are looking at that session'"'"'s tab
CCTN_AWAY_AFTER|60|Seconds without keyboard or mouse use after which the tab in front gets notified too (0 = never)
CCTN_SOUND_DONE|Blow|Sound when Claude finishes (a name from /System/Library/Sounds, or none)
CCTN_SOUND_INPUT|Glass|Sound when Claude needs you (a name from /System/Library/Sounds, or none)
CCTN_CLEAR_ON_TYPE|1|Clear a tab'"'"'s notification when you type in that tab
CCTN_CLEAR_ON_SWITCH|1|Clear a notification when you switch to its tab (needs the watcher)
CCTN_CLEAR_DELAY|2|Seconds to stay on a tab before switching to it clears its notification
CCTN_EXPIRE_AFTER|0|Seconds before a notification removes itself (0 keeps it until cleared)
CCTN_BANNER_CHARS|150|Most characters of Claude'"'"'s reply to show
CCTN_TITLE_PREFIX||Text before every title, to tell these from other notifications
CCTN_ALWAYS_NOTIFY|0|Notify even for sessions that cannot be matched to a tab'

CONFIG_FILE_KEYS=""
CONFIG_MTIME=""

# Plain bash, no awk or grep: a hook can run with a bare PATH, and a default
# that fails to load would read as "off" and silence every notification.
setting_known() {
    local line
    while IFS= read -r line; do
        [ "${line%%|*}" = "$1" ] && return 0
    done <<< "$SETTINGS_TABLE"
    return 1
}

# "clear_delay", "CLEAR_DELAY" and "CCTN_CLEAR_DELAY" all name one setting.
setting_name() {
    local name
    name=$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')
    case "$name" in CCTN_*) ;; *) name="CCTN_$name" ;; esac
    printf '%s' "$name"
}

# Reads NAME=value lines. Never sourced: the file is data, so nothing in it
# runs. Values may be quoted to keep spaces at either end.
load_config() {
    local key
    for key in $CONFIG_FILE_KEYS; do unset "$key"; done
    CONFIG_FILE_KEYS=""
    CONFIG_MTIME=$(/usr/bin/stat -f %m "$CONFIG_FILE" 2>/dev/null)
    [ -f "$CONFIG_FILE" ] || return 0
    # Names the environment set before this file was read. Those win; for the
    # rest, a later line in the file wins over an earlier one.
    local env_keys=" " default rest
    while IFS='|' read -r key default rest; do
        [ -n "${!key+x}" ] && env_keys="$env_keys$key "
    done <<< "$SETTINGS_TABLE"
    local line value first=1
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        # A byte order mark, as some editors save one, would glue onto the
        # first name and hide it.
        [ "$first" = 1 ] && line="${line#$'\xEF\xBB\xBF'}"
        first=0
        case "$line" in ''|[[:space:]]*'#'*|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) continue ;; esac
        key=$(setting_name "$(printf '%s' "${line%%=*}" | tr -d '[:space:]')")
        value="${line#*=}"
        setting_known "$key" || continue
        [[ "$env_keys" == *" $key "* ]] && continue
        value=$(printf '%s' "$value" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        case "$value" in
            \"*\") value="${value#\"}"; value="${value%\"}" ;;
            \'*\') value="${value#\'}"; value="${value%\'}" ;;
        esac
        printf -v "$key" '%s' "$value"
        export "$key"
        [[ " $CONFIG_FILE_KEYS " == *" $key "* ]] || CONFIG_FILE_KEYS="$CONFIG_FILE_KEYS $key"
    done < "$CONFIG_FILE"
}

setting_default() {
    local key default rest
    while IFS='|' read -r key default rest; do
        [ "$key" = "$1" ] && { printf '%s' "$default"; return 0; }
    done <<< "$SETTINGS_TABLE"
}

# The value in force: environment or file, else the default.
setting() {
    local key="$1"
    if [ -n "${!key+x}" ]; then printf '%s' "${!key}"; else setting_default "$key"; fi
}

is_on() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on) return 0 ;;
    esac
    return 1
}

# A whole number of seconds, or the default when the value is anything else.
setting_seconds() {
    local value
    value=$(setting "$1")
    case "$value" in ''|*[!0-9]*) setting_default "$1" ;; *) printf '%s' "$value" ;; esac
}

load_config

# Overridable so the test suite can post without touching real notifications.
GROUP_PREFIX="${CCTN_GROUP_PREFIX:-agent-tab-notify}"

# Empty by default so the title is just the tab name. Set CCTN_TITLE_PREFIX to
# tell these apart from iTerm2's own Claude Code notifications.
TITLE_PREFIX="${CCTN_TITLE_PREFIX:-}"

TERMINAL_NOTIFIER_BUNDLE_ID="fr.julienxx.oss.terminal-notifier"

# One marker file per outstanding notification. The watch loop reads this
# instead of asking terminal-notifier, because `-list ALL` costs about 100ms
# and a directory listing costs nothing. A stale marker is harmless: clearing a
# notification that is no longer showing removes nothing.
# Deliberately not under TMPDIR: hooks run with your shell's TMPDIR and the
# watch agent runs under launchd with a different one, so the marker a hook
# writes would land where the agent never looks.
PENDING_DIR="${CCTN_PENDING_DIR:-$HOME/.cache/cctn-pending}"

pending_path() {
    printf '%s/%s' "$PENDING_DIR" "$(printf '%s' "$1" | tr '/:' '__')"
}

# A handle is "<terminal>:<identifier>". Each terminal offers a different
# identifier, so the kind travels with it rather than being guessed on the way back.
#   iterm:<session uuid>     stable per session
#   terminal:<tty>           Terminal.app exposes tty per tab
#   ghostty:<tab id>         matched by working directory, only when unambiguous
#   tty:<tty>                unresolved; the click works out which terminal owns it
#
# The tty handle exists because asking a terminal anything requires AppleScript,
# which can stall under load while several sessions post at once. Reading the tty
# costs no AppleScript at all, so a notification always carries something the
# click can act on, and the lookup happens when you click instead of when it posts.

# ---------------------------------------------------------------- helpers ---

INPUT=""

read_stdin() {
    # Hooks pipe JSON in. A tty means a human ran this by hand, and reading
    # would hang waiting for input that is never coming.
    if [ -t 0 ]; then INPUT=""; else INPUT=$(cat); fi
}

json_get() {
    [ -n "$INPUT" ] || return 0
    if command -v jq >/dev/null 2>&1; then
        echo "$INPUT" | jq -r "$1 // empty" 2>/dev/null
    else
        echo "$INPUT" | /usr/bin/python3 -c '
import json, sys
key = sys.argv[1].lstrip(".")
try:
    value = json.load(sys.stdin).get(key, "")
except Exception:
    value = ""
print("" if value is None else value if isinstance(value, str) else str(value).lower())
' "$1" 2>/dev/null
    fi
}

# GNU timeout is not on a stock macOS, and a missing one fails open: the command
# never runs and nothing reports why. perl ships with the system.
bounded() { perl -e 'alarm shift; exec @ARGV' "$@" 2>/dev/null; }

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

have_notifier() { command -v terminal-notifier >/dev/null 2>&1; }

# Asking an app a question through a `tell` launches it. This test does not,
# which keeps a session under one terminal from starting three others.
app_running() {
    [ "$(osascript -e "application \"$1\" is running" 2>/dev/null)" = "true" ]
}

# Under tmux the ancestor tty is the pane's pty, owned by the tmux server rather
# than by any terminal. The attached client's tty is the real one.
find_tmux_client_tty() {
    [ -n "${TMUX:-}" ] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    local pane_session
    pane_session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}' 2>/dev/null)
    [ -n "$pane_session" ] || return 0
    tmux list-clients -t "$pane_session" -F '#{client_tty}' 2>/dev/null | head -1
}

# Hooks run without a controlling terminal; the claude process above them has one.
find_ancestor_tty() {
    local pid=$PPID hops=0 ppid tt
    while [ "$hops" -lt 12 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
        read -r ppid tt <<<"$(ps -o ppid=,tty= -p "$pid" 2>/dev/null)"
        [ -n "$ppid" ] || return 0
        if [ -n "$tt" ] && [ "$tt" != "??" ]; then
            echo "/dev/$tt"
            return 0
        fi
        pid=$ppid
        hops=$((hops + 1))
    done
}

session_tty() {
    local tty
    tty=$(find_tmux_client_tty)
    [ -n "$tty" ] || tty=$(find_ancestor_tty)
    echo "$tty"
}

# Codex hooks set CCTN_AGENT=codex in their command; install.sh writes it.
# Its payloads also carry a turn_id, which Claude's do not, so a hand-wired
# Codex hook still counts.
AGENT="claude"

detect_agent() {
    if [ "${CCTN_AGENT:-}" = "codex" ] || [ -n "$(json_get '.turn_id')" ]; then
        AGENT="codex"
    fi
}

# Codex runs hooks either in the tab's own codex process or in a shared
# app-server daemon that serves every tab. The daemon keeps the environment of
# whichever tab started it, so its ITERM_SESSION_ID and TMUX point at that tab,
# not the one the hook is about. The daemon has no tty above it; the tab's own
# process does. With no tty, drop those variables before anything reads them.
forget_daemon_env() {
    [ "$AGENT" = "codex" ] || return 0
    [ -n "$(find_ancestor_tty)" ] && return 0
    unset ITERM_SESSION_ID TMUX TMUX_PANE WARP_FOCUS_URL
}

# Warp's stable build is dev.warp.Warp-Stable; older builds used dev.warp.Warp.
# Prints the first one installed, or nothing. Spotlight answers in about 60ms;
# AppleScript's "path to application id" took 7.5s on a cold first call.
warp_bundle() {
    local id app
    for id in dev.warp.Warp-Stable dev.warp.Warp; do
        [ -n "$(mdfind "kMDItemCFBundleIdentifier == '$id'" 2>/dev/null | head -1)" ] && { echo "$id"; return 0; }
    done
    # Spotlight can be off or still indexing.
    for app in /Applications/Warp.app "$HOME/Applications/Warp.app"; do
        id=$(defaults read "$app/Contents/Info.plist" CFBundleIdentifier 2>/dev/null)
        case "$id" in dev.warp.Warp-Stable|dev.warp.Warp) echo "$id"; return 0 ;; esac
    done
}

# Warp has no scripting dictionary, but since 2026 it gives every shell a link
# that brings that exact session forward: <scheme>://session/<32 hex>, where the
# scheme is warp, warppreview or another channel's. Prints "warp:<scheme>:<id>",
# or nothing outside Warp or when the value is not that shape.
warp_handle() {
    [ "${TERM_PROGRAM:-}" = "WarpTerminal" ] || return 0
    [[ "${WARP_FOCUS_URL:-}" =~ ^(warp[a-z]*)://session/([0-9a-f]{32})$ ]] || return 0
    echo "warp:${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
}

agent_label() {
    if [ "$AGENT" = "codex" ]; then echo "Codex"; else echo "Claude Code"; fi
}

# ------------------------------------------------------- resolve per app ----

# $ITERM_SESSION_ID is preferred but never trusted: it is absent in some
# sessions, and iTerm assigns a new id when it restores a tab, so a stale value
# would point at a tab that no longer exists.
resolve_iterm() {
    app_running "iTerm2" || return 0
    # Unset in some sessions, which is the case this whole fallback exists for.
    local want_id="${ITERM_SESSION_ID:-}"
    osascript - "${want_id##*:}" "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantID to item 1 of argv
  set wantTTY to item 2 of argv
  set ttyMatch to ""
  tell application "iTerm2"
    repeat with w in windows
      set tabIndex to 0
      repeat with t in tabs of w
        set tabIndex to tabIndex + 1
        repeat with s in sessions of t
          if wantID is not "" and (id of s) is wantID then ¬
            return "iterm:" & (id of s) & linefeed & (name of s) & linefeed & tabIndex & linefeed & (count of tabs of w)
          if wantTTY is not "" and (tty of s) is wantTTY then ¬
            set ttyMatch to "iterm:" & (id of s) & linefeed & (name of s) & linefeed & tabIndex & linefeed & (count of tabs of w)
        end repeat
      end repeat
    end repeat
  end tell
  return ttyMatch
end run
APPLESCRIPT
}

resolve_terminal_app() {
    [ -n "$1" ] || return 0
    app_running "Terminal" || return 0
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantTTY to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      set tabIndex to 0
      repeat with t in tabs of w
        set tabIndex to tabIndex + 1
        if (tty of t) is wantTTY then
          -- Terminal tabs have no `name`; asking for one fails with -1700.
          set tabName to ""
          try
            set tabName to custom title of t
          end try
          if tabName is "" then set tabName to (processes of t) as text
          return "terminal:" & wantTTY & linefeed & tabName & linefeed & tabIndex
        end if
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
}

# Ghostty exposes no tty and no pid, so the working directory is the only handle
# available. Two tabs in one project share it, and sending you to the wrong tab
# is worse than sending you nowhere, so a match counts only when it is unique.
resolve_ghostty() {
    [ -n "$1" ] || return 0
    app_running "Ghostty" || return 0
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantDir to item 1 of argv
  set matchIDs to {}
  set matchNames to {}
  set matchIndexes to {}
  tell application "Ghostty"
    repeat with w in windows
      set tabIndex to 0
      repeat with t in tabs of w
        set tabIndex to tabIndex + 1
        repeat with trm in terminals of t
          if (working directory of trm) is wantDir then
            set end of matchIDs to (id of t)
            set end of matchIndexes to tabIndex
            set end of matchNames to (name of t)
          end if
        end repeat
      end repeat
    end repeat
  end tell
  if (count of matchIDs) is 1 then ¬
    return "ghostty:" & (item 1 of matchIDs) & linefeed & (item 1 of matchNames) & linefeed & (item 1 of matchIndexes)
  return ""
end run
APPLESCRIPT
}

# A hook run by the Codex daemon has no tty to match, but Codex titles each tab
# with its thread's name ("<name> | <dir> (codex)"), and the thread's name is in
# Codex's state database. Two tabs can carry the same name, so as with Ghostty a
# match counts only when it is unique. A thread that has no name yet has nothing
# to match.
codex_thread_name() {
    case "$1" in ''|*[!0-9a-f-]*) return 0 ;; esac
    local db
    db=$(ls -t "${CODEX_HOME:-$HOME/.codex}"/state_*.sqlite 2>/dev/null | head -1)
    [ -n "$db" ] || return 0
    /usr/bin/sqlite3 -readonly "$db" "SELECT name FROM threads WHERE id = '$1'" 2>/dev/null | head -1
}

resolve_codex_thread() {
    app_running "iTerm2" || return 0
    local name
    name=$(codex_thread_name "$1")
    [ -n "$name" ] || return 0
    osascript - "$name" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantName to item 1 of argv
  set matchIDs to {}
  set matchNames to {}
  set matchIndexes to {}
  set matchCounts to {}
  tell application "iTerm2"
    repeat with w in windows
      set tabIndex to 0
      repeat with t in tabs of w
        set tabIndex to tabIndex + 1
        repeat with s in sessions of t
          set sName to name of s
          if sName is wantName or sName starts with (wantName & " |") then
            set end of matchIDs to (id of s)
            set end of matchIndexes to tabIndex
            set end of matchCounts to (count of tabs of w)
            set end of matchNames to sName
          end if
        end repeat
      end repeat
    end repeat
  end tell
  if (count of matchIDs) is 1 then ¬
    return "iterm:" & (item 1 of matchIDs) & linefeed & (item 1 of matchNames) & linefeed & (item 1 of matchIndexes) & linefeed & (item 1 of matchCounts)
  return ""
end run
APPLESCRIPT
}

# Tries each running terminal rather than trusting $TERM_PROGRAM, which is absent
# from some hook environments for the same reason $ITERM_SESSION_ID is.
# $2 is a Codex thread id, matched by tab name when no tty matched.
resolve_handle() {
    is_macos || return 0
    local want_tty result
    want_tty=$(session_tty)

    result=$(resolve_iterm "$want_tty")
    [ -n "$result" ] && { echo "$result"; return 0; }

    result=$(resolve_terminal_app "$want_tty")
    [ -n "$result" ] && { echo "$result"; return 0; }

    result=$(resolve_codex_thread "${2:-}")
    [ -n "$result" ] && { echo "$result"; return 0; }

    result=$(resolve_ghostty "${1:-}")
    [ -n "$result" ] && { echo "$result"; return 0; }
}

# --------------------------------------------------------- focus per app ----

focus_iterm() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetID to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is targetID then
            select w
            select t
            select s
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

focus_terminal_app() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantTTY to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if (tty of t) is wantTTY then
          set selected of t to true
          set index of w to 1
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

focus_ghostty() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetID to item 1 of argv
  tell application "Ghostty"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of t) is targetID then
          select tab t
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

# The tab's keyboard shortcut as a title prefix, or its position when it has
# none. iTerm2 maps ⌘1 to ⌘8 to tabs one to eight and ⌘9 to the last tab, so a
# ninth tab that is not the last has no shortcut. Other terminals map ⌘1 to ⌘9
# to tabs one to nine.
tab_shortcut() {
    local app="$1" index="$2" count="$3"
    case "$index" in [1-9]|[1-9][0-9]*) ;; *) return 0 ;; esac
    if [ "$app" = "iterm" ]; then
        if [ "$index" -le 8 ]; then printf '⌘%s: ' "$index"
        elif [ "$index" = "$count" ]; then printf '⌘9: '
        else printf 'Tab %s: ' "$index"
        fi
    elif [ "$index" -le 9 ]; then printf '⌘%s: ' "$index"
    else printf 'Tab %s: ' "$index"
    fi
}

# The session's name from Claude Code's transcript: the one you gave it with
# /rename, else the one Claude generated. This is the fallback title where no
# tab name can be read, as in Warp. About 45ms on a 220MB transcript.
session_name() {
    [ -f "$1" ] || return 0
    grep -a -E '"type":"(custom|ai)-title"' "$1" 2>/dev/null | /usr/bin/python3 -c '
import json, sys
custom = ai = ""
for line in sys.stdin:
    try:
        entry = json.loads(line)
    except Exception:
        continue
    if entry.get("type") == "custom-title":
        custom = entry.get("customTitle") or custom
    elif entry.get("type") == "ai-title":
        ai = entry.get("aiTitle") or ai
print(" ".join((custom or ai).split()))
' 2>/dev/null
}

PERMISSION_DIR="${TMPDIR:-/tmp}/cctn-permission"

# What a permission prompt is asking, from the PermissionRequest payload on
# stdin: "Wants to run: git push origin main". Cut to the banner length.
permission_summary() {
    /usr/bin/python3 -c '
import json, os, sys
limit = int(sys.argv[1])
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
tool = data.get("tool_name") or ""
args = data.get("tool_input") or {}
if not isinstance(args, dict):
    args = {}
cwd = data.get("cwd") or ""

def short_path(path):
    if cwd and path.startswith(cwd.rstrip("/") + "/"):
        return path[len(cwd.rstrip("/")) + 1:]
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + "/") else path

def first_text():
    for value in args.values():
        if isinstance(value, str) and value.strip():
            return value
    return ""

if tool == "Bash":
    text = "Wants to run: " + (args.get("command") or "")
elif tool in ("Edit", "MultiEdit", "NotebookEdit"):
    text = "Wants to edit: " + short_path(args.get("file_path") or args.get("notebook_path") or "")
elif tool == "Write":
    text = "Wants to write: " + short_path(args.get("file_path") or "")
elif tool == "Read":
    text = "Wants to read: " + short_path(args.get("file_path") or "")
elif tool == "WebFetch":
    text = "Wants to fetch: " + (args.get("url") or "")
elif tool == "WebSearch":
    text = "Wants to search: " + (args.get("query") or "")
elif tool.startswith("mcp__"):
    parts = tool.split("__", 2)
    server = parts[1] if len(parts) > 1 else ""
    name = parts[2] if len(parts) > 2 else ""
    # Plugin servers are named plugin_<plugin>_<server>; the server part is
    # the readable one.
    if server.startswith("plugin_"):
        server = server[len("plugin_"):].split("_", 1)[-1]
    elif server.startswith("claude_ai_"):
        server = server[len("claude_ai_"):]
    detail = first_text()
    text = "Wants to use " + server + " " + name + ((": " + detail) if detail else "")
elif tool:
    detail = first_text()
    text = "Wants to use " + tool + ((": " + detail) if detail else "")
else:
    sys.exit(0)
text = " ".join(text.split())
if len(text) > limit:
    cut = text[:limit]
    space = cut.rfind(" ")
    text = (cut[:space] if space > limit // 2 else cut).rstrip() + "…"
print(text)
' "$BANNER_CHARS" 2>/dev/null
}

# A reply as banner text: Markdown removed, a bare lead-in line such as
# "Done." skipped, and cut at a word near what a banner shows in three lines.
# Python because sed and cut count bytes, which splits accented letters.
BANNER_CHARS=$(setting_seconds CCTN_BANNER_CHARS)
[ "$BANNER_CHARS" -gt 0 ] 2>/dev/null || BANNER_CHARS=$(setting_default CCTN_BANNER_CHARS)
clean_reply() {
    /usr/bin/python3 -c '
import re, sys
limit = int(sys.argv[1])
text = sys.stdin.read()
text = re.sub(r"```.*?```", " ", text, flags=re.S)
lines = []
for line in text.splitlines():
    line = re.sub(r"^\s{0,3}(#{1,6}\s+|>\s?|[-*+]\s+|\d+[.)]\s+)", "", line)
    line = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", line)
    line = re.sub(r"`([^`]*)`", r"\1", line)
    line = re.sub(r"(\*\*|__)(.+?)\1", r"\2", line)
    line = re.sub(r"(?<![\w*])\*(?!\s)(.+?)(?<!\s)\*(?![\w*])", r"\1", line)
    line = re.sub(r"~~(.+?)~~", r"\1", line)
    line = re.sub(r"^\s*\|?\s*:?-{3,}.*$", "", line)
    line = " ".join(line.replace("|", " ").split())
    if line:
        lines.append(line)
if len(lines) > 1 and len(lines[0]) <= 20 and lines[0][-1:] in ".:!":
    lines = lines[1:]
text = " ".join(l if i == len(lines) - 1 or l[-1] in ".!?:;,…" else l + "."
               for i, l in enumerate(lines))
if len(text) > limit:
    cut = text[:limit]
    space = cut.rfind(" ")
    if space > limit // 2:
        cut = cut[:space]
    text = cut.rstrip(" ,;:.-") + "…"
print(text)
' "$BANNER_CHARS" 2>/dev/null
}

# Whether Claude stopped only to wait for background agents. Claude Code lists
# the work in flight in the Stop payload, and the turn that ends when the last
# agent finishes notifies as usual. An agent that is itself waiting on a command
# counts as completed and leaves the list, so that case is read from the
# notification that started this turn; its command is still listed, which keeps
# the transcript unread for every other Stop.
waiting_on_agents() {
    printf '%s' "$INPUT" | /usr/bin/python3 -c '
import json, os, sys

AGENT_TYPES = {"subagent", "workflow", "teammate", "cloud session"}
WAITING = "is waiting on its own background work</summary>"

def turn_start(path):
    with open(path, "rb") as transcript:
        transcript.seek(0, os.SEEK_END)
        transcript.seek(max(0, transcript.tell() - 262144))
        lines = transcript.read().splitlines()
    for line in reversed(lines):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if row.get("type") == "user" and row.get("origin"):
            return row
    return {}

try:
    payload = json.load(sys.stdin)
    tasks = payload.get("background_tasks") or []
    if any(task.get("type") in AGENT_TYPES for task in tasks):
        sys.exit(0)
    if tasks:
        row = turn_start(payload.get("transcript_path") or "")
        content = json.dumps(row.get("message", {}).get("content", ""))
        if row.get("origin", {}).get("kind") == "task-notification" and WAITING in content:
            sys.exit(0)
except (OSError, ValueError, AttributeError):
    pass
sys.exit(1)
' 2>/dev/null
}

# ---------------------------------------------------------------- notify ----

cmd_notify() {
    read_stdin
    have_notifier || exit 0
    detect_agent
    forget_daemon_env

    local hook_event transcript_path notification_msg payload_cwd session_dir
    hook_event=$(json_get '.hook_event_name')
    hook_event=${hook_event:-Unknown}

    # Claude re-runs the Stop hook when it continues from its own stop. Nothing
    # is waiting on you at that point.
    if [ "$hook_event" = "Stop" ] && [ "$(json_get '.stop_hook_active')" = "true" ]; then
        exit 0
    fi

    case "$hook_event" in
        Stop) is_on "$(setting CCTN_NOTIFY_ON_DONE)" || exit 0 ;;
        Notification|PermissionRequest) is_on "$(setting CCTN_NOTIFY_ON_INPUT)" || exit 0 ;;
    esac

    if [ "$hook_event" = "Stop" ] && ! is_on "$(setting CCTN_NOTIFY_WHILE_AGENTS_RUN)" && waiting_on_agents; then
        printf '%s event=%s session=%s SKIPPED (background agents running)\n' \
            "$(date '+%H:%M:%S')" "$hook_event" "$(json_get '.session_id' | cut -c1-8)" \
            >> "${TMPDIR:-/tmp}/cctn.log" 2>/dev/null
        exit 0
    fi

    # About a minute after a reply, Claude Code sends a "waiting for your input"
    # reminder. Posting it would replace the notification that shows the reply
    # (one per tab) with a message that says less. Older versions send no
    # notification_type, so the message itself is checked too.
    # Claude Code's PermissionRequest event names the tool and its input; the
    # Notification it sends for the same prompt says only "Claude needs your
    # permission". When this session just posted the detailed one, the generic
    # one would replace it (one notification per tab), so it is dropped.
    local permission_mark
    permission_mark="$PERMISSION_DIR/$(printf '%s' "$(json_get '.session_id')" | tr -c 'A-Za-z0-9_-' '_')"
    if [ "$hook_event" = "PermissionRequest" ]; then
        { mkdir -p "$PERMISSION_DIR" && : > "$permission_mark"; } 2>/dev/null
    elif [ "$hook_event" = "Notification" ] && [ "$(json_get '.notification_type')" = "permission_prompt" ] \
        && [ -n "$(find "$permission_mark" -mmin -10 2>/dev/null)" ]; then
        exit 0
    fi

    if [ "$hook_event" = "Notification" ] && ! is_on "$(setting CCTN_NOTIFY_ON_IDLE)"; then
        local notification_type
        notification_type=$(json_get '.notification_type')
        if [ "$notification_type" = "idle_prompt" ] || \
           { [ -z "$notification_type" ] && [ "$(json_get '.message')" = "Claude is waiting for your input" ]; }; then
            exit 0
        fi
    fi

    transcript_path=$(json_get '.transcript_path')
    notification_msg=$(json_get '.message')
    payload_cwd=$(json_get '.cwd')
    [ -n "$payload_cwd" ] || payload_cwd=$(pwd)
    session_dir=$(basename "$payload_cwd")

    # Claude hands over the final reply in the payload. The transcript can lag
    # behind it when the hook fires, which showed the reply before the last one,
    # so read the transcript only when the payload has nothing.
    local last_assistant_msg=""
    if [ "$hook_event" = "Stop" ]; then
        last_assistant_msg=$(json_get '.last_assistant_message' | clean_reply)
    fi
    # Tool calls and thinking blocks also live in content[], so select on type
    # rather than trusting the first element.
    if [ -z "$last_assistant_msg" ] && [ -f "$transcript_path" ] && [ "$hook_event" = "Stop" ] && command -v jq >/dev/null 2>&1; then
        last_assistant_msg=$(tail -40 "$transcript_path" 2>/dev/null | \
            jq -c 'select(.message.role == "assistant")
                   | [.message.content[]? | select(.type == "text") | .text]
                   | join("\n") | select(. != "")' 2>/dev/null | \
            tail -1 | jq -r '.' 2>/dev/null | clean_reply)
    fi
    # Codex hands over the reply itself rather than a transcript to dig through.
    if [ "$AGENT" = "codex" ]; then
        last_assistant_msg=$(json_get '.last_assistant_message' | clean_reply)
        local tool_name
        tool_name=$(json_get '.tool_name')
        [ -n "$tool_name" ] && notification_msg="Codex wants to use $tool_name"
    fi

    local title msg sound
    case "$hook_event" in
        PermissionRequest)
            title="Input Required"
            msg=$(printf '%s' "$INPUT" | permission_summary)
            msg=${msg:-${notification_msg:-"$(agent_label) needs your permission"}}
            sound=$(setting CCTN_SOUND_INPUT)
            ;;
        Notification)
            title="Input Required"
            msg=${notification_msg:-"$(agent_label) needs your input"}
            sound=$(setting CCTN_SOUND_INPUT)
            ;;
        Stop)
            title="Task Complete"
            msg=${last_assistant_msg:-"Task completed"}
            sound=$(setting CCTN_SOUND_DONE)
            ;;
        *)
            title="$(agent_label)"
            msg=${notification_msg:-"$(agent_label) has an update"}
            sound="default"
            ;;
    esac

    local info="" handle="" tab_title="" tab_index="" tab_count="" claude_session_id
    claude_session_id=$(json_get '.session_id')

    # Background sessions run under Claude's daemon rather than in a tab, so
    # there is no tab to select and no point paying for the lookup. Say so in
    # the notification instead of leaving it looking like a failed resolution.
    # The Codex daemon can inherit these variables from a tab that started it
    # inside Claude Code, so they say nothing about a Codex session.
    if [ "$AGENT" = "claude" ] && { [ "${CLAUDE_CODE_SESSION_KIND:-}" = "bg" ] || [ -n "${CLAUDE_JOB_DIR:-}" ]; }; then
        # $CLAUDE_CODE_SESSION_NAME is truncated to one word ("Evaluate"), while
        # the job's own state file carries the whole name. With no tab to name,
        # this is the only thing that says which job woke you.
        local job_name=""
        if [ -f "${CLAUDE_JOB_DIR:-}/state.json" ]; then
            job_name=$(/usr/bin/python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("name", "") or "")
except Exception:
    print("")
' "$CLAUDE_JOB_DIR/state.json" 2>/dev/null)
        fi
        [ -n "$job_name" ] || job_name="${CLAUDE_CODE_SESSION_NAME:-}"
        tab_title="background job${job_name:+: $job_name}"
    elif [ -n "$(warp_handle)" ]; then
        # Checked before iTerm2: Warp started from an iTerm2 tab inherits its
        # ITERM_SESSION_ID, which would send the click to that iTerm2 tab.
        handle=$(warp_handle)
    elif [ "$AGENT" = "codex" ]; then
        info=$(bounded 8 bash "$SELF" resolve "$payload_cwd" "$claude_session_id")
        handle=$(echo "$info" | head -1)
        tab_title=$(echo "$info" | sed -n 2p)
        tab_index=$(echo "$info" | sed -n 3p)
        tab_count=$(echo "$info" | sed -n 4p)
    else
        info=$(bounded 8 bash "$SELF" resolve "$payload_cwd")
        handle=$(echo "$info" | head -1)
        tab_title=$(echo "$info" | sed -n 2p)
        tab_index=$(echo "$info" | sed -n 3p)
        tab_count=$(echo "$info" | sed -n 4p)
    fi

    # Resolution can come back empty when a terminal is slow to answer, which
    # says nothing about whether the tab exists. Fall back to the raw tty so the
    # click still has somewhere to go, and reuse the last known tab name so the
    # notification can still say which tab it is.
    local raw_tty cache
    raw_tty=$(session_tty)
    cache="${TMPDIR:-/tmp}/cctn-tabnames"
    mkdir -p "$cache" 2>/dev/null
    local cache_file="$cache/$(echo "${raw_tty:-none}" | tr '/' '_')"

    if [ -z "$handle" ]; then
        [ -n "$raw_tty" ] && handle="tty:$raw_tty"
        [ -z "$tab_title" ] && [ -f "$cache_file" ] && tab_title=$(cat "$cache_file")
    elif [ -n "$tab_title" ] && [ -n "$raw_tty" ]; then
        printf '%s' "$tab_title" > "$cache_file" 2>/dev/null
    fi

    # Claude's own session id keeps sibling tabs in one project distinct when no
    # tab resolves. Falling back to the directory collapses them.
    local group_id="${handle#*:}"
    local group_key="$GROUP_PREFIX:${group_id:-${claude_session_id:-$session_dir}}"

    # Silent and non-fatal on purpose: the marker is an optimization for the
    # watch loop, and a notification must still post on a system where this
    # directory cannot be written.
    # No handle means no tab, so the watch loop can never match it and the
    # marker would only keep the loop asking the terminal every second.
    # Warp cannot name its frontmost tab either, so a Warp marker would only
    # keep the loop polling.
    if [ -n "$handle" ] && [ "${handle%%:*}" != "warp" ]; then
        { mkdir -p "$PENDING_DIR" && printf '%s' "$handle" > "$(pending_path "$group_key")"; } 2>/dev/null || true
    fi

    # Raising the wrong terminal would be worse than doing nothing, so an
    # unrecognized one gets no click action at all.
    local fallback_app=""
    case "${TERM_PROGRAM:-}" in
        iTerm.app)      fallback_app="com.googlecode.iterm2" ;;
        Apple_Terminal) fallback_app="com.apple.Terminal" ;;
        vscode)         fallback_app="com.microsoft.VSCode" ;;
        WarpTerminal)   fallback_app=$(warp_bundle) ;;
        ghostty)        fallback_app="com.mitchellh.ghostty" ;;
    esac

    # Sessions started outside a terminal (parented by launchd rather than a tab)
    # have neither a tty nor TERM_PROGRAM, which left their notifications with no
    # click action at all: clicking did nothing whatsoever. Raising the only
    # running terminal is a guess, so make it only when there is nothing to guess
    # between.
    if [ -z "$handle" ] && [ -z "$fallback_app" ]; then
        local running=() app
        for app in iTerm2:com.googlecode.iterm2 Terminal:com.apple.Terminal \
                   Ghostty:com.mitchellh.ghostty; do
            app_running "${app%%:*}" && running+=("${app#*:}")
        done
        [ "${#running[@]}" -eq 1 ] && fallback_app="${running[0]}"
    fi

    # This failure is intermittent and only reproduces under real load across
    # several sessions, so record what each post decided. Without it the only
    # evidence is a notification that already happened.
    # A notification with no handle cannot route anywhere: no tab, and no tty to
    # work one out from later. iTerm2's own integration posts a working one for
    # exactly these sessions, so ours would be a duplicate that does nothing when
    # clicked. Only skip when that integration is installed, since on any other
    # machine a notification that merely raises the terminal still beats silence.
    # That integration covers Claude Code only, so a Codex session always posts.
    # You are already looking at the tab, so a notification would only repeat
    # what is on screen. iTerm2 and Terminal can name their front tab; Ghostty
    # and Warp cannot, so their sessions always notify.
    # Unless you have stepped away: then nobody is looking, and the sound is
    # what calls you back.
    if ! is_on "$(setting CCTN_NOTIFY_WHEN_FOCUSED)" && [ -n "$handle" ] && ! user_is_away; then
        local front_handle
        front_handle=$(tab_in_front)
        if handles_match "$handle" "$front_handle"; then
            printf '%s event=%s session=%s SKIPPED (tab is in front)\n' \
                "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" \
                >> "${TMPDIR:-/tmp}/cctn.log" 2>/dev/null
            exit 0
        fi
    fi

    local iterm_integration=""
    [ "$AGENT" = "claude" ] && grep -q 'iterm2/cc-status' "$HOME/.claude/settings.json" 2>/dev/null && iterm_integration=1
    if [ -z "$handle" ] && [ -n "$iterm_integration" ] && ! is_on "$(setting CCTN_ALWAYS_NOTIFY)"; then
        printf '%s event=%s session=%s SKIPPED (unroutable; iTerm integration active)\n' \
            "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" \
            >> "${TMPDIR:-/tmp}/cctn.log" 2>/dev/null
        exit 0
    fi

    local log="${TMPDIR:-/tmp}/cctn.log"
    printf '%s event=%s session=%s tty=%s handle=%s title=%s\n' \
        "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" \
        "${raw_tty:-none}" "${handle:-NONE}" "${tab_title:-NONE}" >> "$log" 2>/dev/null
    tail -300 "$log" > "$log.tmp" 2>/dev/null && mv "$log.tmp" "$log" 2>/dev/null

    # One bold line: the tab name says which session this is better than the
    # agent and directory do. Without a tab name, fall back to those plus the
    # event, so the notification still says what happened.
    local heading
    if [ -n "$tab_title" ]; then
        # Claude Code starts its tab title with a status glyph (a spinning half
        # moon while working, ✳ when idle). It is already stale by the time the
        # banner shows, and it pushes the name right.
        # Every Claude Code tab ends in "(claude)", so it says nothing here.
        # Codex tabs keep their own label.
        heading=$(printf '%s' "$tab_title" | LC_ALL=en_US.UTF-8 sed -E \
            -e 's/^[^[:alnum:][:space:]]+[[:space:]]+//' -e 's/[[:space:]]+\(claude\)$//')
        # ⌘1 to ⌘9 select a tab by position. Only a fresh lookup has a
        # position: a cached name may have moved.
        heading="$(tab_shortcut "${handle%%:*}" "$tab_index" "$tab_count")$heading"
    else
        heading=$(session_name "$transcript_path")
        [ -n "$heading" ] || heading="$(agent_label) ($session_dir): $title"
    fi

    # terminal-notifier reads its arguments as defaults, so a value starting
    # with "-" can be taken for an option. A zero-width space in front keeps
    # it a value and does not show.
    local zwsp=$'\xE2\x80\x8B'
    case "$msg" in -*) msg="$zwsp$msg" ;; esac
    heading="${TITLE_PREFIX}${heading}"
    case "$heading" in -*) heading="$zwsp$heading" ;; esac

    local args
    args=(
        -title "$heading"
        -message "$msg"
        -group "$group_key"
    )
    # "none" or an empty value means a silent notification.
    case "$(printf '%s' "$sound" | tr '[:upper:]' '[:lower:]')" in
        ''|none|off|0) ;;
        *) args+=(-sound "$sound") ;;
    esac

    if [ -n "$handle" ]; then
        # terminal-notifier is relaunched to handle the click and exits within
        # ~120ms, which is less than one AppleScript round trip. Run detached so
        # selecting the tab outlives the process that started it.
        args+=(-execute "nohup '$SELF' focus '$handle' >/dev/null 2>&1 &")
    elif [ -n "$fallback_app" ]; then
        args+=(-activate "$fallback_app")
    fi

    # terminal-notifier can exit non-zero after posting. A hook that exits
    # non-zero makes Claude Code report it as failed on every Stop, so record
    # the status in the log instead of returning it.
    local status=0
    terminal-notifier "${args[@]}" >/dev/null 2>&1 || status=$?
    if [ "$status" -ne 0 ]; then
        printf '%s event=%s session=%s terminal-notifier exited %s\n' \
            "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" "$status" >> "$log" 2>/dev/null
    fi

    schedule_expiry "$group_key"
    return 0
}

# --------------------------------------------------------------- expire ----

# Timers live under TMPDIR: the hook that starts one and the timer itself share
# an environment, and nothing else reads them.
EXPIRE_DIR="${TMPDIR:-/tmp}/cctn-expire"

expiry_path() {
    printf '%s/%s' "$EXPIRE_DIR" "$(printf '%s' "$1" | tr '/:' '__')"
}

# Removes the notification after CCTN_EXPIRE_AFTER seconds. Each post writes a
# fresh token, and a timer acts only when its token is still the latest, so an
# old timer never removes the newer notification that replaced its own.
schedule_expiry() {
    local seconds token
    seconds=$(setting_seconds CCTN_EXPIRE_AFTER)
    # Without a timer for this post, an older timer must not remove it.
    rm -f "$(expiry_path "$1")" 2>/dev/null
    [ "$seconds" -gt 0 ] 2>/dev/null || return 0
    token="$$.$RANDOM.$(date +%s)"
    { mkdir -p "$EXPIRE_DIR" && printf '%s' "$token" > "$(expiry_path "$1")"; } 2>/dev/null || return 0
    # Detached with every stream closed, so the hook returns at once.
    nohup "$SELF" expire "$1" "$token" "$seconds" </dev/null >/dev/null 2>&1 &
}

cmd_expire() {
    local group="$1" token="$2" seconds="$3"
    [ -n "$group" ] && [ -n "$token" ] || return 0
    sleep "$seconds"
    local current
    current=$(cat "$(expiry_path "$group")" 2>/dev/null)
    [ "$current" = "$token" ] || return 0
    terminal-notifier -remove "$group" >/dev/null 2>&1
    rm -f "$(expiry_path "$group")" "$(pending_path "$group")" 2>/dev/null
}

# ----------------------------------------------------------------- clear ----

cmd_clear() {
    # return, not exit: the watch loop calls this, and exiting would end it.
    have_notifier || return 0

    local keys=()
    if [ -n "${1:-}" ]; then
        keys+=("$GROUP_PREFIX:${1#*:}")
    else
        read_stdin
        is_on "$(setting CCTN_CLEAR_ON_TYPE)" || return 0
        detect_agent
        forget_daemon_env
        local claude_session_id payload_cwd handle raw_tty codex_thread=""
        claude_session_id=$(json_get '.session_id')
        [ -n "$claude_session_id" ] && keys+=("$GROUP_PREFIX:$claude_session_id")
        [ "$AGENT" = "codex" ] && codex_thread="$claude_session_id"
        payload_cwd=$(json_get '.cwd')
        handle=$(warp_handle)
        [ -n "$handle" ] || handle=$(bounded 8 bash "$SELF" resolve "$payload_cwd" "$codex_thread" | head -1)
        [ -n "$handle" ] && keys+=("$GROUP_PREFIX:${handle#*:}")
        # A notification posted while resolution was slow is keyed by tty, which
        # is a different key than the same tab's resolved id.
        raw_tty=$(session_tty)
        [ -n "$raw_tty" ] && keys+=("$GROUP_PREFIX:$raw_tty")
    fi

    # The directory-based key is never cleared: sibling tabs in one project share
    # it, and one of them may still be waiting on you.
    local key
    for key in ${keys+"${keys[@]}"}; do
        terminal-notifier -remove "$key" >/dev/null 2>&1
        rm -f "$(pending_path "$key")" "$(expiry_path "$key")" 2>/dev/null
    done
}

# ----------------------------------------------------------------- focus ----

cmd_focus() {
    local handle="${1:-}"
    local kind="${handle%%:*}"
    local target="${handle#*:}"
    local result="notfound" bundle=""

    case "$kind" in
        iterm)    result=$(focus_iterm "$target");        bundle="com.googlecode.iterm2" ;;
        terminal) result=$(focus_terminal_app "$target"); bundle="com.apple.Terminal" ;;
        ghostty)  result=$(focus_ghostty "$target");      bundle="com.mitchellh.ghostty" ;;
        warp)
            # Opening the link selects the session's window and tab. Raising the
            # app as well covers a link that selects without activating.
            local scheme="${target%%:*}" id="${target#*:}"
            open "$scheme://session/$id" >/dev/null 2>&1 && result="ok"
            if [ "$scheme" = "warp" ]; then
                open -b dev.warp.Warp-Stable >/dev/null 2>&1 || open -b dev.warp.Warp >/dev/null 2>&1
            fi
            ;;
        tty)
            # Deferred lookup: work out which terminal owns this tty now.
            # ITERM_SESSION_ID must be cleared: it describes whoever is running
            # this lookup, and letting it win would focus their tab, not the one
            # the notification is about.
            local found
            found=$(ITERM_SESSION_ID= resolve_iterm "$target" | head -1)
            if [ -n "$found" ]; then
                result=$(focus_iterm "${found#*:}")
                bundle="com.googlecode.iterm2"
            elif [ -n "$(resolve_terminal_app "$target" | head -1)" ]; then
                result=$(focus_terminal_app "$target")
                bundle="com.apple.Terminal"
            fi
            ;;
    esac

    # The tab is gone or was never ours; raising the app is the best left.
    [ "$result" = "ok" ] || [ -z "$bundle" ] || open -b "$bundle"
}

# ---------------------------------------------------------------- doctor ----

doctor_alert_style() {
    /usr/bin/python3 - "$TERMINAL_NOTIFIER_BUNDLE_ID" <<'PY' 2>/dev/null
import os, plistlib, subprocess, sys
target = sys.argv[1]
path = os.path.expanduser("~/Library/Preferences/com.apple.ncprefs.plist")
raw = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", path],
                     capture_output=True).stdout
names = {0: "None", 1: "Banners", 2: "Alerts"}
for app in plistlib.loads(raw).get("apps", []):
    bundle_id = app.get("bundle-id", "")
    if "terminal-notifier" not in bundle_id:
        continue
    flags = app.get("flags")
    style = names.get((flags >> 3) & 3, "?") if isinstance(flags, int) else "?"
    mark = "  <- the one this tool posts through" if bundle_id == target else ""
    print(f"    {bundle_id}: {style}{mark}")
PY
}

cmd_doctor() {
    local ok=0

    echo "agent-tab-notify doctor"
    echo "  executable: $SELF"

    if is_macos; then
        echo "  [ok]   macOS"
    else
        echo "  [FAIL] not macOS; this tool does nothing here"
        ok=1
    fi

    if have_notifier; then
        echo "  [ok]   terminal-notifier: $(command -v terminal-notifier)"
    else
        echo "  [FAIL] terminal-notifier missing. Install it: brew install terminal-notifier"
        ok=1
    fi

    echo "  terminals running:"
    local app
    for app in iTerm2 Terminal Ghostty; do
        if app_running "$app"; then echo "    $app: yes"; else echo "    $app: no"; fi
    done

    local info handle name
    info=$(bounded 8 bash "$SELF" resolve "$(pwd)")
    handle=$(echo "$info" | head -1)
    name=$(echo "$info" | sed -n 2p)
    if [ -n "$handle" ]; then
        echo "  [ok]   this session resolves to a tab: $handle"
        echo "         tab name: $name"
    else
        echo "  [warn] this session does not resolve to a tab."
        echo "         Notifications still post and raise your terminal, without selecting a tab."
        echo "         Warp has no scripting support, and Ghostty can only be matched when one"
        echo "         tab is open on this directory."
    fi

    local settings="$HOME/.claude/settings.json"
    if [ -f "$settings" ] && grep -q -E "agent-tab-notify|claude-code-tab-notify" "$settings" 2>/dev/null; then
        echo "  [ok]   hooks registered in $settings"
    else
        echo "  [FAIL] hooks not registered. Run ./install.sh"
        ok=1
    fi

    local codex_dir="${CODEX_HOME:-$HOME/.codex}"
    if [ -d "$codex_dir" ]; then
        if grep -q -E "agent-tab-notify|claude-code-tab-notify" "$codex_dir/hooks.json" 2>/dev/null; then
            echo "  [ok]   Codex hooks registered in $codex_dir/hooks.json"
            echo "         Codex runs them only once trusted: type /hooks in Codex to review them."
        else
            echo "  [warn] Codex is installed but its hooks are not registered. Run ./install.sh"
        fi
    fi

    echo "  alert style (System Settings > Notifications):"
    local styles
    styles=$(doctor_alert_style)
    if [ -n "$styles" ]; then
        echo "$styles"
        echo "    Alerts stay on screen until dismissed; Banners fade after a few seconds."
    else
        echo "    could not read com.apple.ncprefs.plist"
    fi

    local changed
    changed=$(printf '%s' "$CONFIG_FILE_KEYS" | wc -w | tr -d ' ')
    echo "  settings: $CONFIG_FILE ($changed changed from the defaults; run: config)"
    if [ "$(setting_seconds CCTN_CLEAR_DELAY)" -gt 0 ] || ! is_on "$(setting CCTN_CLEAR_ON_SWITCH)"; then
        launchctl list 2>/dev/null | grep -q -E '(agent|claude-code)-tab-notify.watch' \
            || echo "         note: the switch-tab settings only matter while the watcher runs, and it is not loaded"
    fi

    return $ok
}

# ----------------------------------------------------------------- watch ----

# Claude Code fires no hook when you switch terminal tabs, so clearing a
# notification on arrival, rather than on your first keystroke, needs a process
# of its own.
#
# The loop is built to cost nothing while nothing is waiting on you. Reading the
# frontmost app takes about 8ms and no AppleScript; asking iTerm which session is
# frontmost takes about 146ms, so that question is only asked when a notification
# is actually outstanding and a terminal that can answer it is in front. An idle
# tick is one lsappinfo call and one directory listing.

WATCH_INTERVAL="${CCTN_WATCH_INTERVAL:-1}"

watch_frontmost_bundle() {
    local asn
    asn=$(lsappinfo front 2>/dev/null) || return 0
    [ -n "$asn" ] || return 0
    lsappinfo info -only bundleid "$asn" 2>/dev/null \
        | sed -n 's/.*bundleID="\([^"]*\)".*/\1/p'
}

# Empty when the terminal cannot name its frontmost tab. Ghostty and Warp are
# absent on purpose: neither exposes a per-tab identifier, and clearing the
# wrong tab's notification loses the one thing that was waiting on you.
# Errors are reported, never swallowed. Under launchd this call needs Automation
# permission for the agent itself, and a denial is silent: osascript returns
# nothing and the loop would look like it was simply finding no tabs.
watch_say() {
    [ -n "${CCTN_WATCH_QUIET:-}" ] && return 0
    echo "$1" >&2
}

watch_ask() {
    local out err rc
    err=$(mktemp)
    # Not bounded(): it discards stderr, and the error is what this reports.
    out=$(perl -e 'alarm shift; exec @ARGV' 5 osascript -e "$1" 2>"$err"); rc=$?
    if [ -n "$(cat "$err" 2>/dev/null)" ]; then
        watch_say "watch: osascript failed ($(head -1 "$err"))"
    fi
    rm -f "$err"
    [ $rc -eq 0 ] && printf '%s' "$out"
}

# True when the keyboard and mouse have been idle for CCTN_AWAY_AFTER seconds.
# HIDIdleTime is in nanoseconds. Reading it takes about 20ms.
user_is_away() {
    local away idle_ns
    away=$(setting_seconds CCTN_AWAY_AFTER)
    [ "$away" -gt 0 ] 2>/dev/null || return 1
    idle_ns=$(ioreg -c IOHIDSystem 2>/dev/null | sed -n 's/.*"HIDIdleTime" = \([0-9]*\).*/\1/p' | head -1)
    [ -n "$idle_ns" ] || return 1
    [ $((idle_ns / 1000000000)) -ge "$away" ]
}

# The handle of the tab in front, then its tty, when the front app is a
# terminal that can say which tab that is. Costs one lsappinfo call, plus one
# AppleScript round trip only when iTerm2 or Terminal is in front.
tab_in_front() {
    local bundle
    bundle=$(watch_frontmost_bundle)
    CCTN_WATCH_QUIET=1 watch_frontmost_handle "$bundle"
}

# $1 is a session's handle; $2 is tab_in_front's output (handle, then tty).
# They name one tab when the handles are equal, or when $1 is an unresolved
# tty handle carrying the front tab's tty.
handles_match() {
    local front_handle front_tty
    front_handle=$(printf '%s\n' "$2" | sed -n 1p)
    front_tty=$(printf '%s\n' "$2" | sed -n 2p)
    [ -n "$1" ] && [ -n "$front_handle" ] || return 1
    [ "$1" = "$front_handle" ] && return 0
    [ -n "$front_tty" ] && [ "$1" = "tty:$front_tty" ]
}

watch_frontmost_handle() {
    case "$1" in
        com.googlecode.iterm2)
            # The tty comes in the same round trip: a notification posted while
            # resolution was slow is keyed by tty, not by session id.
            local both
            both=$(watch_ask 'tell application "iTerm2" to tell current window to tell current tab to tell current session to return (id as text) & "|" & (tty as text)')
            [ -n "${both%%|*}" ] && printf 'iterm:%s\n%s\n' "${both%%|*}" "${both#*|}"
            ;;
        com.apple.Terminal)
            local tty
            tty=$(watch_ask 'tell application "Terminal" to get tty of selected tab of front window')
            [ -n "$tty" ] && printf 'terminal:%s\n%s\n' "$tty" "$tty"
            ;;
    esac
}

# A marker outlives its tab when a session ends without you replying: the tab
# is closed, the session crashes, or the Mac restarts. While any marker exists
# the loop asks the terminal which tab is in front every second, so one dead
# marker costs an AppleScript call a second indefinitely. A marker is dropped
# only when its tab is provably gone; if the terminal cannot be asked, it stays.
PRUNE_INTERVAL="${CCTN_PRUNE_INTERVAL:-300}"

prune_pending() {
    [ -d "$PENDING_DIR" ] || return 0

    local iterm_ids="" iterm_known=0
    if app_running "iTerm2"; then
        iterm_ids=$(watch_ask 'tell application "iTerm2" to get id of every session of every tab of every window')
        [ -n "$iterm_ids" ] && iterm_known=1
    else
        # No iTerm means no iTerm tabs.
        iterm_known=1
    fi
    iterm_ids=",$(printf '%s' "$iterm_ids" | tr -d ' '),"

    # macOS reuses tty numbers, so a live tty only vouches for a marker written
    # since this boot. iTerm ids are not bounded this way: restored tabs keep them.
    local boot_epoch
    boot_epoch=$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\),.*/\1/p')

    local f handle kind target tty_live written_before_boot
    for f in "$PENDING_DIR"/*; do
        [ -f "$f" ] || continue
        # notify writes the marker before posting, so a fresh one may belong
        # to a notification still on its way.
        [ -n "$(find "$f" -mmin +1 2>/dev/null)" ] || continue

        handle=$(cat "$f" 2>/dev/null)
        kind="${handle%%:*}"
        target="${handle#*:}"
        case "$kind" in
            iterm)
                [ "$iterm_known" = 1 ] || continue
                case "$iterm_ids" in *",$target,"*) continue ;; esac
                ;;
            tty|terminal)
                written_before_boot=0
                [ -n "$boot_epoch" ] && [ "$(/usr/bin/stat -f %m "$f" 2>/dev/null || echo 0)" -lt "$boot_epoch" ] \
                    && written_before_boot=1
                tty_live=$(ps -t "${target#/dev/}" -o pid= 2>/dev/null)
                [ -n "$tty_live" ] && [ "$written_before_boot" = 0 ] && continue
                ;;
            "")
                # Written before notify stopped writing handle-less markers.
                ;;
            *)
                continue
                ;;
        esac
        rm -f "$f"
        watch_say "watch: dropped marker $(basename "$f") (${handle:-no tab}): its tab is gone"
    done
}

cmd_watch() {
    # A launchd agent gets PATH=/usr/bin:/bin:/usr/sbin:/sbin, which does not
    # include Homebrew, so say what is missing rather than exiting quietly.
    local dep
    for dep in terminal-notifier lsappinfo osascript; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "watch cannot start: $dep is not on PATH ($PATH)" >&2
            exit 1
        fi
    done
    echo "watch started, polling every ${WATCH_INTERVAL}s, markers in $PENDING_DIR" >&2

    prune_pending
    local last_prune=$SECONDS

    # last_handle is the tab you were last seen on, arrived_at when you got
    # there, and cleared whether this visit has already cleared it. fresh means
    # no notification was waiting on the previous tick, so nobody was watching
    # which tab you were on.
    local last_handle="" arrived_at=0 cleared=1 fresh=1
    while :; do
        sleep "$WATCH_INTERVAL"

        if [ $((SECONDS - last_prune)) -ge "$PRUNE_INTERVAL" ]; then
            prune_pending
            last_prune=$SECONDS
        fi

        # Settings can change while the agent runs; one stat per tick notices.
        if [ "$(/usr/bin/stat -f %m "$CONFIG_FILE" 2>/dev/null)" != "$CONFIG_MTIME" ]; then
            load_config
            watch_say "watch: settings reloaded from $CONFIG_FILE"
        fi
        is_on "$(setting CCTN_CLEAR_ON_SWITCH)" || { fresh=1; continue; }

        # Nothing outstanding: the cheapest possible tick.
        local pending=""
        [ -d "$PENDING_DIR" ] && pending=$(ls -1 "$PENDING_DIR" 2>/dev/null | head -1)
        [ -n "$pending" ] || { fresh=1; continue; }

        local bundle handle
        bundle=$(watch_frontmost_bundle)
        case "$bundle" in
            com.googlecode.iterm2|com.apple.Terminal) ;;
            # Being in another app counts as having left every tab.
            *) last_handle=""; fresh=0; continue ;;
        esac

        local front front_tty
        front=$(watch_frontmost_handle "$bundle")
        handle=$(printf '%s\n' "$front" | sed -n 1p)
        front_tty=$(printf '%s\n' "$front" | sed -n 2p)
        [ -n "$handle" ] || continue

        # The first notification found you already on this tab, so you have
        # not arrived anywhere. A notification for the tab you are looking at
        # must wait until you leave and come back, not vanish within a second.
        if [ "$fresh" = 1 ]; then
            last_handle="$handle"; cleared=1; fresh=0
            continue
        fi

        if [ "$handle" != "$last_handle" ]; then
            last_handle="$handle"; arrived_at=$SECONDS; cleared=0
        fi
        # Sitting in one tab must not re-clear it every second.
        [ "$cleared" = 1 ] && continue
        [ $((SECONDS - arrived_at)) -ge "$(setting_seconds CCTN_CLEAR_DELAY)" ] || continue

        cmd_clear "$handle"
        [ -n "$front_tty" ] && cmd_clear "tty:$front_tty"
        cleared=1
    done
}

# ---------------------------------------------------------------- config ----

cmd_config() {
    local action="${1:-show}"
    case "$action" in
        show|"") config_show ;;
        set)
            [ $# -ge 3 ] || { echo "usage: config set NAME VALUE" >&2; return 1; }
            config_write "$(setting_name "$2")" "${*:3}" ;;
        unset)
            [ $# -ge 2 ] || { echo "usage: config unset NAME" >&2; return 1; }
            config_write "$(setting_name "$2")" ;;
        path) echo "$CONFIG_FILE" ;;
        *) echo "usage: config [show | set NAME VALUE | unset NAME | path]" >&2; return 1 ;;
    esac
}

config_show() {
    if [ -f "$CONFIG_FILE" ]; then echo "Settings file: $CONFIG_FILE"
    else echo "Settings file: $CONFIG_FILE (not created yet; every setting is at its default)"
    fi
    echo
    local key default description value source short
    while IFS='|' read -r key default description; do
        value=$(setting "$key")
        if [[ " $CONFIG_FILE_KEYS " == *" $key "* ]]; then source="file"
        elif [ -n "${!key+x}" ]; then source="environment"
        else source="default"
        fi
        short=$(printf '%s' "${key#CCTN_}" | tr '[:upper:]' '[:lower:]')
        printf '  %-16s = %-8s (%s)\n      %s\n' "$short" "\"$value\"" "$source" "$description"
    done <<< "$SETTINGS_TABLE"
    echo
    echo "Change one with: $(basename "$SELF") config set clear_delay 5"
    echo "Whether notifications stay on screen is set in System Settings, Notifications,"
    echo "terminal-notifier: Alerts stay until dismissed, Banners fade after a few seconds."
}

# A new settings file lists every setting, commented out at its default, with
# its description above it, so the file explains itself when edited by hand.
config_template() {
    printf '# agent-tab-notify settings\n'
    printf '#\n'
    printf '# Remove the "# " in front of a setting to change it. A line that starts\n'
    printf '# with "#" is ignored. On/off settings take 1 (on) or 0 (off).\n'
    printf '# Or use the command: agent-tab-notify config set NAME VALUE\n'
    local key default description
    while IFS='|' read -r key default description; do
        printf '\n# %s\n# %s="%s"\n' "$description" "$key" "$default"
    done <<< "$SETTINGS_TABLE"
}

# Changes one setting's line in place, so the rest of the file, comments
# included, stays as it is. Setting a value replaces the active line, or else
# the commented-out template line, or else adds a line at the end. Unsetting
# turns the line back into its commented-out default.
config_write() {
    local key="$1" value="${2-}" removing=0
    [ $# -lt 2 ] && removing=1
    setting_known "$key" || { echo "unknown setting: $key (run: $(basename "$SELF") config)" >&2; return 1; }
    case "$value" in *\"*|*$'\n'*) echo "a value cannot contain a double quote or a line break" >&2; return 1 ;; esac
    mkdir -p "$(dirname "$CONFIG_FILE")" || return 1
    [ -f "$CONFIG_FILE" ] || config_template > "$CONFIG_FILE"

    local new_line
    if [ "$removing" = 1 ]; then new_line="# $key=\"$(setting_default "$key")\""
    else new_line="$key=\"$value\""
    fi

    # Prefer the active line; fall back to the commented-out one.
    local line name has_active=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in '#'*) continue ;; esac
        name=$(setting_name "$(printf '%s' "${line%%=*}" | tr -d '[:space:]')")
        [ "$name" = "$key" ] && { has_active=1; break; }
    done < "$CONFIG_FILE"

    local tmp="$CONFIG_FILE.tmp.$$" placed=0 stripped
    {
        while IFS= read -r line || [ -n "$line" ]; do
            stripped="${line#\#}"; stripped="${stripped# }"
            name=$(setting_name "$(printf '%s' "${stripped%%=*}" | tr -d '[:space:]')")
            case "$line" in
                ''|*'='*) ;;
                *) printf '%s\n' "$line"; continue ;;
            esac
            if [ "$name" != "$key" ]; then printf '%s\n' "$line"; continue; fi
            case "$line" in
                '#'*)
                    # The commented-out line: take it over only when no active
                    # line exists. Unsetting leaves it alone.
                    if [ "$has_active" = 0 ] && [ "$removing" = 0 ] && [ "$placed" = 0 ]; then
                        printf '%s\n' "$new_line"; placed=1
                    else
                        printf '%s\n' "$line"
                    fi ;;
                *)
                    # An active line: the first becomes the new line, any later
                    # duplicates go, since they would win over it.
                    if [ "$placed" = 0 ]; then printf '%s\n' "$new_line"; placed=1; fi ;;
            esac
        done < "$CONFIG_FILE"
        [ "$placed" = 1 ] || [ "$removing" = 1 ] || printf '%s\n' "$new_line"
    } > "$tmp" && cat "$tmp" > "$CONFIG_FILE"   # cat, not mv: keeps a symlinked file a symlink
    rm -f "$tmp"

    if [ "$removing" = 1 ]; then echo "$key is back to its default, \"$(setting_default "$key")\""
    else echo "$key=\"$value\" saved in $CONFIG_FILE"
    fi
    if [ -n "${!key+x}" ] && [[ " $CONFIG_FILE_KEYS " != *" $key "* ]]; then
        echo "note: $key is also set in your environment, which wins over the file"
    fi
}

# ------------------------------------------------------------------ main ----

# Sourcing runs no command, so the test suite can call the per-terminal
# functions directly instead of reimplementing them.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    case "${1:-help}" in
        notify)  cmd_notify ;;
        clear)   shift; cmd_clear "${1:-}" ;;
        watch)   cmd_watch ;;
        focus)   shift; cmd_focus "${1:-}" ;;
        resolve) shift; resolve_handle "${1:-}" "${2:-}" ;;
        doctor)  cmd_doctor ;;
        prune)   prune_pending ;;
        expire)  shift; cmd_expire "${1:-}" "${2:-}" "${3:-0}" ;;
        config)  shift; cmd_config "$@" ;;
        *)       sed -n '2,14p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    esac
fi
