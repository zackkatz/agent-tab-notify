#!/bin/bash
# claude-code-tab-notify
# Claude Code notifications that take you to the right terminal tab.
#
# Subcommands:
#   notify    post a notification for this session   (Stop, Notification hooks)
#   clear     drop this session's notification       (UserPromptSubmit hook)
#   watch     clear a tab's notification when you switch to it (background)
#   focus H   select the tab for handle H            (run by a notification click)
#   resolve   print this session's handle, then its tab name
#   doctor    check the pieces this depends on

set -uo pipefail

# The click callback is stored inside every delivered notification, so this path
# must be the real one on disk. A symlinked or relative invocation would bake in
# a path that stops resolving the moment the caller's directory changes.
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
SELF="$SELF_DIR/$(basename "${BASH_SOURCE[0]}")"

# Overridable so the test suite can post without touching real notifications.
GROUP_PREFIX="${CCTN_GROUP_PREFIX:-claude-code-tab-notify}"

# iTerm2's own Claude Code integration posts its own notifications, so a title
# prefix is the only way to tell at a glance which one you are looking at.
TITLE_PREFIX="${CCTN_TITLE_PREFIX:-cctn: }"

TERMINAL_NOTIFIER_BUNDLE_ID="fr.julienxx.oss.terminal-notifier"

# One marker file per outstanding notification. The watch loop reads this
# instead of asking terminal-notifier, because `-list ALL` costs about 100ms
# and a directory listing costs nothing. A stale marker is harmless: clearing a
# notification that is no longer showing removes nothing.
# Deliberately not under TMPDIR: hooks run with your shell's TMPDIR and the
# watch agent runs under launchd with a different one, so the marker a hook
# writes would land where the agent never looks.
PENDING_DIR="${CCTN_PENDING_DIR:-$HOME/.cache/cctn-pending}"

pending_path() {
    printf '%s/%s' "$PENDING_DIR" "$(printf '%s' "$1" | tr '/:' '__')"
}

# A handle is "<terminal>:<identifier>". Each terminal offers a different
# identifier, so the kind travels with it rather than being guessed on the way back.
#   iterm:<session uuid>     stable per session
#   terminal:<tty>           Terminal.app exposes tty per tab
#   ghostty:<tab id>         matched by working directory, only when unambiguous
#   tty:<tty>                unresolved; the click works out which terminal owns it
#
# The tty handle exists because asking a terminal anything requires AppleScript,
# which can stall under load while several sessions post at once. Reading the tty
# costs no AppleScript at all, so a notification always carries something the
# click can act on, and the lookup happens when you click instead of when it posts.

# ---------------------------------------------------------------- helpers ---

INPUT=""

read_stdin() {
    # Hooks pipe JSON in. A tty means a human ran this by hand, and reading
    # would hang waiting for input that is never coming.
    if [ -t 0 ]; then INPUT=""; else INPUT=$(cat); fi
}

json_get() {
    [ -n "$INPUT" ] || return 0
    if command -v jq >/dev/null 2>&1; then
        echo "$INPUT" | jq -r "$1 // empty" 2>/dev/null
    else
        echo "$INPUT" | /usr/bin/python3 -c '
import json, sys
key = sys.argv[1].lstrip(".")
try:
    value = json.load(sys.stdin).get(key, "")
except Exception:
    value = ""
print("" if value is None else value if isinstance(value, str) else str(value).lower())
' "$1" 2>/dev/null
    fi
}

# GNU timeout is not on a stock macOS, and a missing one fails open: the command
# never runs and nothing reports why. perl ships with the system.
bounded() { perl -e 'alarm shift; exec @ARGV' "$@" 2>/dev/null; }

is_macos() { [ "$(uname -s)" = "Darwin" ]; }

have_notifier() { command -v terminal-notifier >/dev/null 2>&1; }

# Asking an app a question through a `tell` launches it. This test does not,
# which keeps a session under one terminal from starting three others.
app_running() {
    [ "$(osascript -e "application \"$1\" is running" 2>/dev/null)" = "true" ]
}

# Under tmux the ancestor tty is the pane's pty, owned by the tmux server rather
# than by any terminal. The attached client's tty is the real one.
find_tmux_client_tty() {
    [ -n "${TMUX:-}" ] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    local pane_session
    pane_session=$(tmux display-message -p -t "${TMUX_PANE:-}" '#{session_id}' 2>/dev/null)
    [ -n "$pane_session" ] || return 0
    tmux list-clients -t "$pane_session" -F '#{client_tty}' 2>/dev/null | head -1
}

# Hooks run without a controlling terminal; the claude process above them has one.
find_ancestor_tty() {
    local pid=$PPID hops=0 ppid tt
    while [ "$hops" -lt 12 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
        read -r ppid tt <<<"$(ps -o ppid=,tty= -p "$pid" 2>/dev/null)"
        [ -n "$ppid" ] || return 0
        if [ -n "$tt" ] && [ "$tt" != "??" ]; then
            echo "/dev/$tt"
            return 0
        fi
        pid=$ppid
        hops=$((hops + 1))
    done
}

session_tty() {
    local tty
    tty=$(find_tmux_client_tty)
    [ -n "$tty" ] || tty=$(find_ancestor_tty)
    echo "$tty"
}

# ------------------------------------------------------- resolve per app ----

# $ITERM_SESSION_ID is preferred but never trusted: it is absent in some
# sessions, and iTerm assigns a new id when it restores a tab, so a stale value
# would point at a tab that no longer exists.
resolve_iterm() {
    app_running "iTerm2" || return 0
    # Unset in some sessions, which is the case this whole fallback exists for.
    local want_id="${ITERM_SESSION_ID:-}"
    osascript - "${want_id##*:}" "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantID to item 1 of argv
  set wantTTY to item 2 of argv
  set ttyMatch to ""
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if wantID is not "" and (id of s) is wantID then ¬
            return "iterm:" & (id of s) & linefeed & (name of s)
          if wantTTY is not "" and (tty of s) is wantTTY then ¬
            set ttyMatch to "iterm:" & (id of s) & linefeed & (name of s)
        end repeat
      end repeat
    end repeat
  end tell
  return ttyMatch
end run
APPLESCRIPT
}

resolve_terminal_app() {
    [ -n "$1" ] || return 0
    app_running "Terminal" || return 0
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantTTY to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if (tty of t) is wantTTY then
          -- Terminal tabs have no `name`; asking for one fails with -1700.
          set tabName to ""
          try
            set tabName to custom title of t
          end try
          if tabName is "" then set tabName to (processes of t) as text
          return "terminal:" & wantTTY & linefeed & tabName
        end if
      end repeat
    end repeat
  end tell
  return ""
end run
APPLESCRIPT
}

# Ghostty exposes no tty and no pid, so the working directory is the only handle
# available. Two tabs in one project share it, and sending you to the wrong tab
# is worse than sending you nowhere, so a match counts only when it is unique.
resolve_ghostty() {
    [ -n "$1" ] || return 0
    app_running "Ghostty" || return 0
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantDir to item 1 of argv
  set matchIDs to {}
  set matchNames to {}
  tell application "Ghostty"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with trm in terminals of t
          if (working directory of trm) is wantDir then
            set end of matchIDs to (id of t)
            set end of matchNames to (name of t)
          end if
        end repeat
      end repeat
    end repeat
  end tell
  if (count of matchIDs) is 1 then ¬
    return "ghostty:" & (item 1 of matchIDs) & linefeed & (item 1 of matchNames)
  return ""
end run
APPLESCRIPT
}

# Tries each running terminal rather than trusting $TERM_PROGRAM, which is absent
# from some hook environments for the same reason $ITERM_SESSION_ID is.
resolve_handle() {
    is_macos || return 0
    local want_tty result
    want_tty=$(session_tty)

    result=$(resolve_iterm "$want_tty")
    [ -n "$result" ] && { echo "$result"; return 0; }

    result=$(resolve_terminal_app "$want_tty")
    [ -n "$result" ] && { echo "$result"; return 0; }

    result=$(resolve_ghostty "${1:-}")
    [ -n "$result" ] && { echo "$result"; return 0; }
}

# --------------------------------------------------------- focus per app ----

focus_iterm() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetID to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (id of s) is targetID then
            select w
            select t
            select s
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

focus_terminal_app() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set wantTTY to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if (tty of t) is wantTTY then
          set selected of t to true
          set index of w to 1
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

focus_ghostty() {
    osascript - "$1" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set targetID to item 1 of argv
  tell application "Ghostty"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of t) is targetID then
          select tab t
          activate
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  return "notfound"
end run
APPLESCRIPT
}

# ---------------------------------------------------------------- notify ----

cmd_notify() {
    read_stdin
    have_notifier || exit 0

    local hook_event transcript_path notification_msg payload_cwd session_dir
    hook_event=$(json_get '.hook_event_name')
    hook_event=${hook_event:-Unknown}

    # Claude re-runs the Stop hook when it continues from its own stop. Nothing
    # is waiting on you at that point.
    if [ "$hook_event" = "Stop" ] && [ "$(json_get '.stop_hook_active')" = "true" ]; then
        exit 0
    fi

    transcript_path=$(json_get '.transcript_path')
    notification_msg=$(json_get '.message')
    payload_cwd=$(json_get '.cwd')
    [ -n "$payload_cwd" ] || payload_cwd=$(pwd)
    session_dir=$(basename "$payload_cwd")

    # Tool calls and thinking blocks also live in content[], so select on type
    # rather than trusting the first element.
    local last_assistant_msg=""
    if [ -f "$transcript_path" ] && [ "$hook_event" = "Stop" ] && command -v jq >/dev/null 2>&1; then
        last_assistant_msg=$(tail -40 "$transcript_path" 2>/dev/null | \
            jq -r 'select(.message.role == "assistant")
                   | [.message.content[]? | select(.type == "text") | .text]
                   | join(" ")' 2>/dev/null | \
            grep -v '^$' | tail -1 | tr '\n' ' ' | cut -c1-100)
    fi

    local title msg sound
    case "$hook_event" in
        Notification)
            title="Input Required"
            msg=${notification_msg:-"Claude needs your input"}
            sound="Glass"
            ;;
        Stop)
            title="Task Complete"
            msg=${last_assistant_msg:-"Task completed"}
            sound="Blow"
            ;;
        *)
            title="Claude Code"
            msg=${notification_msg:-"Claude has an update"}
            sound="default"
            ;;
    esac

    local info="" handle="" tab_title="" claude_session_id
    claude_session_id=$(json_get '.session_id')

    # Background sessions run under Claude's daemon rather than in a tab, so
    # there is no tab to select and no point paying for the lookup. Say so in
    # the notification instead of leaving it looking like a failed resolution.
    if [ "${CLAUDE_CODE_SESSION_KIND:-}" = "bg" ] || [ -n "${CLAUDE_JOB_DIR:-}" ]; then
        # $CLAUDE_CODE_SESSION_NAME is truncated to one word ("Evaluate"), while
        # the job's own state file carries the whole name. With no tab to name,
        # this is the only thing that says which job woke you.
        local job_name=""
        if [ -f "${CLAUDE_JOB_DIR:-}/state.json" ]; then
            job_name=$(/usr/bin/python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("name", "") or "")
except Exception:
    print("")
' "$CLAUDE_JOB_DIR/state.json" 2>/dev/null)
        fi
        [ -n "$job_name" ] || job_name="${CLAUDE_CODE_SESSION_NAME:-}"
        tab_title="background job${job_name:+: $job_name}"
    else
        info=$(bounded 8 bash "$SELF" resolve "$payload_cwd")
        handle=$(echo "$info" | head -1)
        tab_title=$(echo "$info" | sed -n 2p)
    fi

    # Resolution can come back empty when a terminal is slow to answer, which
    # says nothing about whether the tab exists. Fall back to the raw tty so the
    # click still has somewhere to go, and reuse the last known tab name so the
    # notification can still say which tab it is.
    local raw_tty cache
    raw_tty=$(session_tty)
    cache="${TMPDIR:-/tmp}/cctn-tabnames"
    mkdir -p "$cache" 2>/dev/null
    local cache_file="$cache/$(echo "${raw_tty:-none}" | tr '/' '_')"

    if [ -z "$handle" ]; then
        [ -n "$raw_tty" ] && handle="tty:$raw_tty"
        [ -z "$tab_title" ] && [ -f "$cache_file" ] && tab_title=$(cat "$cache_file")
    elif [ -n "$tab_title" ] && [ -n "$raw_tty" ]; then
        printf '%s' "$tab_title" > "$cache_file" 2>/dev/null
    fi

    # Claude's own session id keeps sibling tabs in one project distinct when no
    # tab resolves. Falling back to the directory collapses them.
    local group_id="${handle#*:}"
    local group_key="$GROUP_PREFIX:${group_id:-${claude_session_id:-$session_dir}}"

    # Silent and non-fatal on purpose: the marker is an optimization for the
    # watch loop, and a notification must still post on a system where this
    # directory cannot be written.
    { mkdir -p "$PENDING_DIR" && printf '%s' "$handle" > "$(pending_path "$group_key")"; } 2>/dev/null || true

    # Raising the wrong terminal would be worse than doing nothing, so an
    # unrecognized one gets no click action at all.
    local fallback_app=""
    case "${TERM_PROGRAM:-}" in
        iTerm.app)      fallback_app="com.googlecode.iterm2" ;;
        Apple_Terminal) fallback_app="com.apple.Terminal" ;;
        vscode)         fallback_app="com.microsoft.VSCode" ;;
        WarpTerminal)   fallback_app="dev.warp.Warp" ;;
        ghostty)        fallback_app="com.mitchellh.ghostty" ;;
    esac

    # Sessions started outside a terminal (parented by launchd rather than a tab)
    # have neither a tty nor TERM_PROGRAM, which left their notifications with no
    # click action at all: clicking did nothing whatsoever. Raising the only
    # running terminal is a guess, so make it only when there is nothing to guess
    # between.
    if [ -z "$handle" ] && [ -z "$fallback_app" ]; then
        local running=() app
        for app in iTerm2:com.googlecode.iterm2 Terminal:com.apple.Terminal \
                   Ghostty:com.mitchellh.ghostty; do
            app_running "${app%%:*}" && running+=("${app#*:}")
        done
        [ "${#running[@]}" -eq 1 ] && fallback_app="${running[0]}"
    fi

    # This failure is intermittent and only reproduces under real load across
    # several sessions, so record what each post decided. Without it the only
    # evidence is a notification that already happened.
    # A notification with no handle cannot route anywhere: no tab, and no tty to
    # work one out from later. iTerm2's own integration posts a working one for
    # exactly these sessions, so ours would be a duplicate that does nothing when
    # clicked. Only skip when that integration is installed, since on any other
    # machine a notification that merely raises the terminal still beats silence.
    local iterm_integration=""
    grep -q 'iterm2/cc-status' "$HOME/.claude/settings.json" 2>/dev/null && iterm_integration=1
    if [ -z "$handle" ] && [ -n "$iterm_integration" ] && [ -z "${CCTN_ALWAYS_NOTIFY:-}" ]; then
        printf '%s event=%s session=%s SKIPPED (unroutable; iTerm integration active)\n' \
            "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" \
            >> "${TMPDIR:-/tmp}/cctn.log" 2>/dev/null
        exit 0
    fi

    local log="${TMPDIR:-/tmp}/cctn.log"
    printf '%s event=%s session=%s tty=%s handle=%s title=%s\n' \
        "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" \
        "${raw_tty:-none}" "${handle:-NONE}" "${tab_title:-NONE}" >> "$log" 2>/dev/null
    tail -300 "$log" > "$log.tmp" 2>/dev/null && mv "$log.tmp" "$log" 2>/dev/null

    local args
    args=(
        -title "${TITLE_PREFIX}Claude Code ($session_dir)"
        -subtitle "${tab_title:-$title}"
        -message "$msg"
        -sound "$sound"
        -group "$group_key"
    )

    if [ -n "$handle" ]; then
        # terminal-notifier is relaunched to handle the click and exits within
        # ~120ms, which is less than one AppleScript round trip. Run detached so
        # selecting the tab outlives the process that started it.
        args+=(-execute "nohup '$SELF' focus '$handle' >/dev/null 2>&1 &")
    elif [ -n "$fallback_app" ]; then
        args+=(-activate "$fallback_app")
    fi

    # terminal-notifier can exit non-zero after posting. A hook that exits
    # non-zero makes Claude Code report it as failed on every Stop, so record
    # the status in the log instead of returning it.
    local status=0
    terminal-notifier "${args[@]}" >/dev/null 2>&1 || status=$?
    if [ "$status" -ne 0 ]; then
        printf '%s event=%s session=%s terminal-notifier exited %s\n' \
            "$(date '+%H:%M:%S')" "$hook_event" "${claude_session_id:0:8}" "$status" >> "$log" 2>/dev/null
    fi
    return 0
}

# ----------------------------------------------------------------- clear ----

cmd_clear() {
    have_notifier || exit 0

    local keys=()
    if [ -n "${1:-}" ]; then
        keys+=("$GROUP_PREFIX:${1#*:}")
    else
        read_stdin
        local claude_session_id payload_cwd handle raw_tty
        claude_session_id=$(json_get '.session_id')
        [ -n "$claude_session_id" ] && keys+=("$GROUP_PREFIX:$claude_session_id")
        payload_cwd=$(json_get '.cwd')
        handle=$(bounded 8 bash "$SELF" resolve "$payload_cwd" | head -1)
        [ -n "$handle" ] && keys+=("$GROUP_PREFIX:${handle#*:}")
        # A notification posted while resolution was slow is keyed by tty, which
        # is a different key than the same tab's resolved id.
        raw_tty=$(session_tty)
        [ -n "$raw_tty" ] && keys+=("$GROUP_PREFIX:$raw_tty")
    fi

    # The directory-based key is never cleared: sibling tabs in one project share
    # it, and one of them may still be waiting on you.
    local key
    for key in ${keys+"${keys[@]}"}; do
        terminal-notifier -remove "$key" >/dev/null 2>&1
        rm -f "$(pending_path "$key")" 2>/dev/null
    done
}

# ----------------------------------------------------------------- focus ----

cmd_focus() {
    local handle="${1:-}"
    local kind="${handle%%:*}"
    local target="${handle#*:}"
    local result="notfound" bundle=""

    case "$kind" in
        iterm)    result=$(focus_iterm "$target");        bundle="com.googlecode.iterm2" ;;
        terminal) result=$(focus_terminal_app "$target"); bundle="com.apple.Terminal" ;;
        ghostty)  result=$(focus_ghostty "$target");      bundle="com.mitchellh.ghostty" ;;
        tty)
            # Deferred lookup: work out which terminal owns this tty now.
            # ITERM_SESSION_ID must be cleared: it describes whoever is running
            # this lookup, and letting it win would focus their tab, not the one
            # the notification is about.
            local found
            found=$(ITERM_SESSION_ID= resolve_iterm "$target" | head -1)
            if [ -n "$found" ]; then
                result=$(focus_iterm "${found#*:}")
                bundle="com.googlecode.iterm2"
            elif [ -n "$(resolve_terminal_app "$target" | head -1)" ]; then
                result=$(focus_terminal_app "$target")
                bundle="com.apple.Terminal"
            fi
            ;;
    esac

    # The tab is gone or was never ours; raising the app is the best left.
    [ "$result" = "ok" ] || [ -z "$bundle" ] || open -b "$bundle"
}

# ---------------------------------------------------------------- doctor ----

doctor_alert_style() {
    /usr/bin/python3 - "$TERMINAL_NOTIFIER_BUNDLE_ID" <<'PY' 2>/dev/null
import os, plistlib, subprocess, sys
target = sys.argv[1]
path = os.path.expanduser("~/Library/Preferences/com.apple.ncprefs.plist")
raw = subprocess.run(["plutil", "-convert", "xml1", "-o", "-", path],
                     capture_output=True).stdout
names = {0: "None", 1: "Banners", 2: "Alerts"}
for app in plistlib.loads(raw).get("apps", []):
    bundle_id = app.get("bundle-id", "")
    if "terminal-notifier" not in bundle_id:
        continue
    flags = app.get("flags")
    style = names.get((flags >> 3) & 3, "?") if isinstance(flags, int) else "?"
    mark = "  <- the one this tool posts through" if bundle_id == target else ""
    print(f"    {bundle_id}: {style}{mark}")
PY
}

cmd_doctor() {
    local ok=0

    echo "claude-code-tab-notify doctor"
    echo "  executable: $SELF"

    if is_macos; then
        echo "  [ok]   macOS"
    else
        echo "  [FAIL] not macOS; this tool does nothing here"
        ok=1
    fi

    if have_notifier; then
        echo "  [ok]   terminal-notifier: $(command -v terminal-notifier)"
    else
        echo "  [FAIL] terminal-notifier missing. Install it: brew install terminal-notifier"
        ok=1
    fi

    echo "  terminals running:"
    local app
    for app in iTerm2 Terminal Ghostty; do
        if app_running "$app"; then echo "    $app: yes"; else echo "    $app: no"; fi
    done

    local info handle name
    info=$(bounded 8 bash "$SELF" resolve "$(pwd)")
    handle=$(echo "$info" | head -1)
    name=$(echo "$info" | sed -n 2p)
    if [ -n "$handle" ]; then
        echo "  [ok]   this session resolves to a tab: $handle"
        echo "         tab name: $name"
    else
        echo "  [warn] this session does not resolve to a tab."
        echo "         Notifications still post and raise your terminal, without selecting a tab."
        echo "         Warp has no scripting support, and Ghostty can only be matched when one"
        echo "         tab is open on this directory."
    fi

    local settings="$HOME/.claude/settings.json"
    if [ -f "$settings" ] && grep -q "claude-code-tab-notify" "$settings" 2>/dev/null; then
        echo "  [ok]   hooks registered in $settings"
    else
        echo "  [FAIL] hooks not registered. Run ./install.sh"
        ok=1
    fi

    echo "  alert style (System Settings > Notifications):"
    local styles
    styles=$(doctor_alert_style)
    if [ -n "$styles" ]; then
        echo "$styles"
        echo "    Alerts stay on screen until dismissed; Banners fade after a few seconds."
    else
        echo "    could not read com.apple.ncprefs.plist"
    fi

    return $ok
}

# ----------------------------------------------------------------- watch ----

# Claude Code fires no hook when you switch terminal tabs, so clearing a
# notification on arrival, rather than on your first keystroke, needs a process
# of its own.
#
# The loop is built to cost nothing while nothing is waiting on you. Reading the
# frontmost app takes about 8ms and no AppleScript; asking iTerm which session is
# frontmost takes about 146ms, so that question is only asked when a notification
# is actually outstanding and a terminal that can answer it is in front. An idle
# tick is one lsappinfo call and one directory listing.

WATCH_INTERVAL="${CCTN_WATCH_INTERVAL:-1}"

watch_frontmost_bundle() {
    local asn
    asn=$(lsappinfo front 2>/dev/null) || return 0
    [ -n "$asn" ] || return 0
    lsappinfo info -only bundleid "$asn" 2>/dev/null \
        | sed -n 's/.*bundleID="\([^"]*\)".*/\1/p'
}

# Empty when the terminal cannot name its frontmost tab. Ghostty and Warp are
# absent on purpose: neither exposes a per-tab identifier, and clearing the
# wrong tab's notification loses the one thing that was waiting on you.
# Errors are reported, never swallowed. Under launchd this call needs Automation
# permission for the agent itself, and a denial is silent: osascript returns
# nothing and the loop would look like it was simply finding no tabs.
watch_say() {
    [ -n "${CCTN_WATCH_QUIET:-}" ] && return 0
    echo "$1" >&2
}

watch_ask() {
    local out err rc
    err=$(mktemp)
    out=$(bounded 5 osascript -e "$1" 2>"$err"); rc=$?
    if [ -n "$(cat "$err" 2>/dev/null)" ]; then
        watch_say "watch: osascript failed ($(head -1 "$err"))"
    fi
    rm -f "$err"
    [ $rc -eq 0 ] && printf '%s' "$out"
}

watch_frontmost_handle() {
    case "$1" in
        com.googlecode.iterm2)
            local id
            id=$(watch_ask 'tell application "iTerm2" to tell current window to tell current tab to tell current session to get id')
            [ -n "$id" ] && printf 'iterm:%s' "$id"
            ;;
        com.apple.Terminal)
            local tty
            tty=$(watch_ask 'tell application "Terminal" to get tty of selected tab of front window')
            [ -n "$tty" ] && printf 'terminal:%s' "$tty"
            ;;
    esac
}

cmd_watch() {
    # A launchd agent gets PATH=/usr/bin:/bin:/usr/sbin:/sbin, which does not
    # include Homebrew, so say what is missing rather than exiting quietly.
    local dep
    for dep in terminal-notifier lsappinfo osascript; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            echo "watch cannot start: $dep is not on PATH ($PATH)" >&2
            exit 1
        fi
    done
    echo "watch started, polling every ${WATCH_INTERVAL}s, markers in $PENDING_DIR" >&2

    local last_handle=""
    while :; do
        sleep "$WATCH_INTERVAL"

        # Nothing outstanding: the cheapest possible tick.
        [ -d "$PENDING_DIR" ] || continue
        local pending
        pending=$(ls -1 "$PENDING_DIR" 2>/dev/null | head -1)
        [ -n "$pending" ] || { last_handle=""; continue; }

        local bundle handle
        bundle=$(watch_frontmost_bundle)
        case "$bundle" in
            com.googlecode.iterm2|com.apple.Terminal) ;;
            *) last_handle=""; continue ;;
        esac

        handle=$(watch_frontmost_handle "$bundle")
        [ -n "$handle" ] || continue

        # Only act when the frontmost tab changed. Sitting in one tab must not
        # re-clear it every second, or a notification arriving for the tab you
        # are already looking at would be wiped before you saw it.
        [ "$handle" = "$last_handle" ] && continue
        last_handle="$handle"

        cmd_clear "$handle"
    done
}

# ------------------------------------------------------------------ main ----

# Sourcing runs no command, so the test suite can call the per-terminal
# functions directly instead of reimplementing them.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    case "${1:-help}" in
        notify)  cmd_notify ;;
        clear)   shift; cmd_clear "${1:-}" ;;
        watch)   cmd_watch ;;
        focus)   shift; cmd_focus "${1:-}" ;;
        resolve) shift; resolve_handle "${1:-}" ;;
        doctor)  cmd_doctor ;;
        *)       sed -n '2,11p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    esac
fi
